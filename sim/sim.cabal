cabal-version:      2.4
name:               rel-sim
version:            0.1.0.0
synopsis:           Offline order-book candle generator for rel
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Sim.Types
                      Sim.Engine
                      Sim.Gen
    build-depends:    base >=4 && <5,
                      containers,
                      splitmix
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -Wredundant-constraints -O2

executable sim
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base,
                      rel-sim
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O2

test-suite spec
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base,
                      containers,
                      rel-sim,
                      QuickCheck
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat
