cabal-version:      2.4
name:               rel-sim
version:            0.1.0.0
synopsis:           Offline order-book candle generator for rel
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Sim.Types
                      Sim.Engine
                      Sim.Gen
                      Sim.GenH
                      Sim.Sinus
                      Sim.TickGen
                      Sim.TickGenH
                      Sim.Cli
                      Sim.Csv
                      Sim.Lvl
                      Sim.Entropy
                      Sim.Fft
                      Sim.Ind
                      Sim.Markov
                      Sim.Dtw
                      Sim.DtwIndex
                      Sim.ML.Data
                      Sim.ML.Model
                      Sim.ML.Train
                      Sim.Strat.Rules
                      Sim.Strat.Backtest
                      Sim.Strat.Optimize
                      Sim.Strat.Dsl
                      Sim.Resume
                      Sim.Run
                      Sim.Mcp.Server
                      Sim.Mcp.Tools
                      Sim.Mcp.Editor
    other-modules:    Sim.Internal
    build-depends:    base >=4 && <5,
                      aeson,
                      array,
                      bytestring,
                      containers,
                      directory,
                      network,
                      scientific,
                      splitmix,
                      text,
                      vector
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -Wredundant-constraints -O2 -fPIC

executable sim
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base,
                      rel-sim
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O2

executable mcp
    hs-source-dirs:   app
    main-is:          Mcp.hs
    build-depends:    base,
                      rel-sim
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O2

executable dtw
    hs-source-dirs:   app
    main-is:          DtwMain.hs
    build-depends:    base,
                      containers,
                      directory,
                      rel-sim
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O2 -threaded -rtsopts -with-rtsopts=-N

foreign-library simffi
    type:             native-shared
    hs-source-dirs:   ffi
    other-modules:    SimFFI
    build-depends:    base,
                      bytestring,
                      containers,
                      directory,
                      rel-sim,
                      vector
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O2 -fPIC -threaded -rtsopts
    if os(linux)
        ghc-options:  -optl-Wl,-z,origin

test-suite spec
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base,
                      aeson,
                      bytestring,
                      containers,
                      rel-sim,
                      QuickCheck,
                      splitmix,
                      vector
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O1
