cabal-version:      2.4
name:               rel-sim
version:            0.1.0.0
synopsis:           Offline order-book candle generator for rel
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Sim.Types
                      Sim.Engine
                      Sim.Gen
                      Sim.GenH
                      Sim.Sinus
                      Sim.TickGen
                      Sim.TickGenH
                      Sim.Cli
                      Sim.Csv
                      Sim.Lvl
                      Sim.Entropy
                      Sim.Fft
                      Sim.Resume
    other-modules:    Sim.Internal
    build-depends:    base >=4 && <5,
                      array,
                      bytestring,
                      containers,
                      splitmix,
                      vector
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -Wredundant-constraints -O2 -fPIC

executable sim
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base,
                      rel-sim
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O2

foreign-library simffi
    type:             native-shared
    hs-source-dirs:   ffi
    other-modules:    SimFFI
    build-depends:    base,
                      bytestring,
                      directory,
                      rel-sim
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O2 -fPIC -threaded
    if os(linux)
        ghc-options:  -optl-Wl,-z,origin

test-suite spec
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base,
                      containers,
                      rel-sim,
                      QuickCheck,
                      vector
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O1
